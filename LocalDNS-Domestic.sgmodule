#!name=LocalDNS 国内DNS分流 v1.0.1
#!desc=版本1.0.1（2026-10-17）。国内网站单独走国内DNS，其余走海外DNS不泄露。基于Sukka的Local DNS Mapping，补上domestic.conf里的国内常用域名。

[Host]
# ===== 1. 国内 DoH 服务器自身的地址（固定，防止循环解析）=====
dns.alidns.com = 223.5.5.5, 223.6.6.6, 2400:3200:baba::1, 2400:3200::1
dot.pub = server:119.29.29.29
doh.pub = server:119.29.29.29
dns.pub = server:119.29.29.29
doh.360.cn = server:101.198.198.198

# ===== 2. 大厂各用自家 DNS（Sukka 维护，会自动更新）=====
RULE-SET:https://ruleset.skk.moe/Modules/Rules/sukka_local_dns_mapping/alibaba.conf = server:https://dns.alidns.com/dns-query
RULE-SET:https://ruleset.skk.moe/Modules/Rules/sukka_local_dns_mapping/tencent.conf = server:https://doh.pub/dns-query
RULE-SET:https://ruleset.skk.moe/Modules/Rules/sukka_local_dns_mapping/bilibili.conf = server:https://doh.pub/dns-query
RULE-SET:https://ruleset.skk.moe/Modules/Rules/sukka_local_dns_mapping/xiaomi.conf = server:https://doh.pub/dns-query
RULE-SET:https://ruleset.skk.moe/Modules/Rules/sukka_local_dns_mapping/bytedance.conf = server:180.184.2.2
RULE-SET:https://ruleset.skk.moe/Modules/Rules/sukka_local_dns_mapping/baidu.conf = server:180.76.76.76
RULE-SET:https://ruleset.skk.moe/Modules/Rules/sukka_local_dns_mapping/qihoo360.conf = server:https://doh.360.cn/dns-query

# ===== 3. 热点登录页、局域网走系统 DNS =====
RULE-SET:https://ruleset.skk.moe/Modules/Rules/sukka_local_dns_mapping/hotspot_captive_portal.conf = server:system
*.m2m = server:system
injections.adguard.org = server:system
local.adguard.org = server:system
*.bogon = server:system
RULE-SET:https://ruleset.skk.moe/Modules/Rules/sukka_local_dns_mapping/lan_without_real_ip.conf = server:system
RULE-SET:https://ruleset.skk.moe/Modules/Rules/sukka_local_dns_mapping/lan_with_realip.conf = server:system
cdn.jsdelivr.net = testingcf.jsdelivr.net

# ===== 4. 其余国内常用域名（来自 Sukka 的 domestic.conf，统一问阿里 DNS）=====
