[Script]
# 抓包
WeTalk-Capture = type=http-request, pattern=^https:\/\/api\.wetalkapp\.com\/app\/queryBalanceAndBonus, script-path=https://raw.githubusercontent.com/hwz1115/Surge-Module/refs/heads/main/JS/WeTalk.js, requires-body=false, max-size=0, timeout=30

# 早上 8:20
WeTalk-Task-Morning = type=cron, cronexp=20 8 * * *, script-path=https://raw.githubusercontent.com/hwz1115/Surge-Module/refs/heads/main/JS/WeTalk.js, timeout=120, wake-system=1

# 晚上 20:20
WeTalk-Task-Evening = type=cron, cronexp=20 20 * * *, script-path=https://raw.githubusercontent.com/hwz1115/Surge-Module/refs/heads/main/JS/WeTalk.js, timeout=120, wake-system=1

[MITM]
hostname = %APPEND% api.wetalkapp.com
