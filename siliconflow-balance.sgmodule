#!name=硅基流动余额监控
#!desc=捕获控制台登录态，定时查询余额并推送提醒（API 接口已下线，改用控制台内部接口）
#!author=Muse

# 使用前：把下面两处 URL 换成你实际托管两个 js 文件的 https 地址，
# 或在 Surge App 内手动新建脚本并粘贴对应文件内容。

[Script]
硅基流动_登录态捕获 = type=http-request,pattern=^https:\/\/cloud\.siliconflow\.com\/walletd-server\/api\/v1\/subject\/profile\/peek,requires-body=0,script-path=https://raw.githubusercontent.com/hwz1115/Surge-Module/refs/heads/main/JS/sf_cookie_capture.js,timeout=10
硅基流动_余额定时查询 = type=cron,cronexp=0 * * * *,wake-system=1,timeout=20,script-path=https://REPLACE_WITH_YOUR_HOST/sf_balance_cron.js

[MITM]
hostname = %APPEND% cloud.siliconflow.com
