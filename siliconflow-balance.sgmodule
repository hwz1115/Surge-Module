#!name=硅基流动余额监控
#!version=v1.6（2026-10-08）修复名称不显示：版本号改成 #! 格式；每天 12、18、23 点查询，每次都通知；脚本为 sf_balance.js v1.4
#!desc=打开控制台时自动记住登录态；每天 12、18、23 点查询余额并通知，低于设定金额时标题提示偏低
#!author=Muse
#!arguments=threshold:10
#!arguments-desc=threshold：余额低于多少元时提示偏低

[Script]
硅基流动_登录态捕获 = type=http-request,pattern=^https:\/\/[^\/]+\.siliconflow\.(cn|com)\/walletd-server\/api\/v1\/subject\/,requires-body=0,script-path=https://raw.githubusercontent.com/hwz1115/Surge-Module/refs/heads/main/JS/sf_balance.js,timeout=10
硅基流动_余额定时查询 = type=cron,cronexp="0 12,18,23 * * *",wake-system=1,timeout=20,script-path=https://raw.githubusercontent.com/hwz1115/Surge-Module/refs/heads/main/JS/sf_balance.js,argument=threshold={{{threshold}}}

[MITM]
hostname = %APPEND% *.siliconflow.cn, *.siliconflow.com

