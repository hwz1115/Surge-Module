#!name=GitHub Star Push Time
#!desc=在 GitHub App 已加星标仓库列表的语言标签后显示最近推送时间（含请求参数清理，避免污染后续查询）
#!author=瀬戸 明日葉 / TomCatXue（Surge 移植：hwz1115）
#!category=GitHub
#!version=1.0

# 说明：
# 本模块整合了两个来源的逻辑：
# 1. 瀬戸 明日葉（OkadaMei）原版 Surge Body Rewrite jq 脚本 —— 负责注入 pushedAt/updatedAt 并在响应里给语言名追加时间后缀。
# 2. TomCatXue（MyCookieCenter）Loon 插件里新增的“请求参数清理”逻辑 —— 移植为 Surge jq 写法：
#    当 App 点进某个仓库详情、请求体里的 variables.name 字段意外带着之前注入的时间后缀时，
#    在发出请求前先把后缀剥离干净，避免因为字段被污染导致查询失败或显示异常。

[Body Rewrite]
http-request-jq ^https?://api\.github\.com/graphql(?:\?.*)?$ 'def suffix_re: " · (刚刚|[0-9]+分钟前|[0-9]+小时前|[0-9]+天前|[0-9]{4}-[0-9]{2}-[0-9]{2})$"; if ((.variables.name? // null) != null) and ((.variables.name | type) == "string") and (.variables.name | test(suffix_re)) then .variables.name |= sub(suffix_re; "") elif ((.operationName == "StarredRepositoriesForUser") or ((.query | type) == "string" and (.query | contains("RepositoryListItemFragment")))) and (.query | type) == "string" and ((.query | contains("pushedAt")) | not) then .query |= sub("fragment RepositoryListItemFragment on Repository \\{"; "fragment RepositoryListItemFragment on Repository { pushedAt updatedAt") else . end'
http-response-jq ^https?://api\.github\.com/graphql(?:\?.*)?$ 'def push_label($value): (($value | fromdateiso8601) as $t | (now | floor) as $n | ([$n - $t, 0] | max) as $d | if $d < 60 then "刚刚" elif $d < 3600 then ((($d / 60) | floor | tostring) + "分钟前") elif $d < 86400 then ((($d / 3600) | floor | tostring) + "小时前") elif $d < 2592000 then ((($d / 86400) | floor | tostring) + "天前") else ($t | strftime("%Y-%m-%d")) end); if (.data.user.starredRepositories.nodes | type) != "array" then . else .data.user.starredRepositories.nodes |= map(if (.pushedAt // .updatedAt | type) != "string" or (.primaryLanguage | type) != "object" or (.primaryLanguage.name | type) != "string" or (.primaryLanguage.name | test(" · (刚刚|[0-9]+分钟前|[0-9]+小时前|[0-9]+天前|[0-9]{4}-[0-9]{2}-[0-9]{2})$")) then . else (.pushedAt // .updatedAt) as $raw | (try push_label($raw) catch null) as $label | if $label == null then . else .primaryLanguage.name = (.primaryLanguage.name + " · " + $label) end end) end'

[MITM]
hostname = %APPEND% api.github.com
